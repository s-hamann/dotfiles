snippet file "file module"
ansible.builtin.file:
	path: '${1}'
	state: ${2:#file|link|directory|hard|touch|absent}
	owner: ${3:root}
	group: ${4:root}
	mode: ${5}
	src: ${6}
	follow: ${7:#true|false}
	force: ${8:#true|false}
	recurse: ${9:#true|false}
endsnippet

snippet copy "copy module"
ansible.builtin.copy:
	dest: '${1}'
	src: '${2}'
	remote_src: ${3:#true|false}
	content: ${4}
	directory_mode: ${5}
	follow: ${6:#true|false}
	force: ${7:#true|false}
	owner: ${8:root}
	group: ${9:root}
	mode: ${10}
	validate: ${11}
endsnippet

snippet template "template module"
ansible.builtin.template:
	dest: '${1}'
	src: '${2}'
	follow: ${4:#true|false}
	owner: ${5:root}
	group: ${6:root}
	mode: ${7}
	validate: ${8}
endsnippet

snippet lineinfile "lineinfile module"
ansible.builtin.lineinfile:
	path: '${1}'
	line: '${2}'
	regexp: '${3}'
	backrefs: ${4:#true|false}
	insertbefore: ${5:#BOF|*regex*}
	insertafter: ${6:#EOF|*regex*}
	create: ${7:#true|false}
	owner: ${8:root}
	group: ${9:root}
	mode: ${10}
	state: ${11:#present|absent}
	validate: ${12}
endsnippet

snippet replace "replace module"
ansible.builtin.replace:
	path: '${1}'
	regexp: '${2}'
	replace: '${3}'
	before: ${4}
	after: ${5}
	owner: ${6:root}
	group: ${7:root}
	mode: ${8}
	validate: ${9}
endsnippet

snippet cron "cron module"
ansible.builtin.cron:
	name: ${1}
	job: ${2}
	user: ${3:root}
	cron_file: ${4}
	state: ${5:#present|absent}
	minute: ${6:*}
	hour: ${7:*}
	day: ${8:*}
	month: ${9:*}
	weekday: ${10:*}
endsnippet

snippet cron-env "cron module"
ansible.builtin.cron:
	env: true
	name: ${1}
	value: ${2}
	user: ${3:root}
	cron_file: ${4}
	state: ${5:#present|absent}
endsnippet

snippet package "package module"
ansible.builtin.package:
	name: ${1}
	state: ${2:#present|absent}
endsnippet

snippet service "service module"
ansible.builtin.service:
	name: ${1}
	enabled: ${2:#true|false}
	state: "{{ ansible_facts['is_chroot'] | ansible.builtin.ternary(omit, '${3:#started|stopped|restarted|reloaded}') }}"
endsnippet

snippet distro_vars "include distribution-specific vars files"
- name: 'Gather OS specific variables'
	ansible.builtin.include_vars: "{{ vars_file }}"
	loop:
		- default.yml
		- "{{ ansible_facts['os_family'] | lower }}.yml"
		- "{{ ansible_facts['distribution'] | lower }}.yml"
		- "{{ ansible_facts['distribution'] | lower }}-{{ ansible_facts['distribution_major_version'] }}.yml"
		- "{{ ansible_facts['distribution'] | lower }}-{{ ansible_facts['distribution_version'] | ansible.builtin.regex_search('[0-9]+\\\\.[0-9]+') }}.yml"
		- "{{ ansible_facts['distribution'] | lower }}-{{ ansible_facts['distribution_version'] }}.yml"
	loop_control:
		loop_var: vars_file
	when: "(vars_file is ansible.builtin.abs and vars_file is ansible.builtin.file) or (vars_file is not ansible.builtin.abs and (role_path ~ '/vars/' ~ vars_file) is ansible.builtin.file)"

endsnippet
